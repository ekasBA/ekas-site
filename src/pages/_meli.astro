---
// Κατάλογος μελών με αναζήτηση ονόματος. Τα δεδομένα βγαίνουν από το scripts/import_export.py (members.json).
// Η αναζήτηση της αρχικής στέλνει εδώ με ?q=όνομα.
import Layout from '~/layouts/PageLayout.astro';
import PageShell from '~/components/ekas/PageShell.astro';
import { getPermalink } from '~/utils/permalinks';

// Ο κατάλογος (src/data/members.json) υπάρχει μόνο όσο η σελίδα είναι ανοιχτή (βλ. utils/members.ts). Διαβάζεται
// έτσι ώστε η απουσία του να μη σπάει τον έλεγχο του κώδικα.
interface Member {
  name: string;
  group: string;
  cv: string | null;
}
const found = Object.values(import.meta.glob<{ default: Member[] }>('/src/data/members.json', { eager: true }));
const members: Member[] = found[0]?.default ?? [];

const metadata = {
  title: 'Μέλη',
  description:
    'Μέλη της Ελληνικής Κοινότητας Ανάλυσης Συμπεριφοράς που έχουν συναινέσει για την ανάρτηση του βιογραφικού τους.',
};

const groups = [...new Set(members.map((m) => m.group))];
---

<Layout metadata={metadata}>
  <PageShell title="Μέλη" subtitle="Όσοι έχουν συναινέσει για την ανάρτηση του βιογραφικού τους.">
    <label class="sr-only" for="member-search">Αναζήτηση μέλους</label>
    <input
      id="member-search"
      type="search"
      placeholder="Αναζήτηση με όνομα"
      autocomplete="off"
      class="ekas-member-search w-full border border-gray-300 bg-white px-4 py-3 text-lg text-heading focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary"
    />
    <p id="member-count" class="mt-3 min-h-5 text-sm text-muted" aria-live="polite"></p>

    {
      groups.map((group) => (
        <div class="member-group mt-8">
          <h2 class="font-heading text-2xl text-heading">{group}</h2>
          <ul class="mt-4 divide-y divide-gray-200 border-y border-gray-200">
            {members
              .filter((m) => m.group === group)
              .map((m) => (
                <li class="member-item flex items-center justify-between gap-4 py-3">
                  <span class="text-base font-medium text-heading">{m.name}</span>
                  {m.cv && (
                    <a
                      class="whitespace-nowrap text-sm font-semibold text-primary underline underline-offset-4 hover:text-secondary"
                      href={m.cv}
                      target="_blank"
                      rel="noopener"
                    >
                      Βιογραφικό
                    </a>
                  )}
                </li>
              ))}
          </ul>
        </div>
      ))
    }

    <p id="member-empty" class="mt-8 hidden text-base text-default">Δεν βρέθηκε μέλος με αυτό το όνομα.</p>

    <p class="mt-8 text-base text-default">
      <a class="font-semibold text-primary underline underline-offset-4" href={getPermalink('/eggrafi')}
        >Εγγραφή - Μέλη</a
      >
    </p>
  </PageShell>

  <style>
    .ekas-member-search {
      border-radius: var(--ekas-btn-radius);
    }
  </style>

  <script>
    // Αναζήτηση χωρίς τόνους και χωρίς διάκριση πεζών και κεφαλαίων. Κάθε λέξη που γράφεται πρέπει να υπάρχει στο όνομα.
    const strip = (s: string) => s.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase();

    const setup = () => {
      const input = document.getElementById('member-search') as HTMLInputElement | null;
      if (!input || input.dataset.wired) return;
      input.dataset.wired = '1';
      const items = Array.from(document.querySelectorAll<HTMLElement>('.member-item'));
      const groups = Array.from(document.querySelectorAll<HTMLElement>('.member-group'));
      const count = document.getElementById('member-count')!;
      const empty = document.getElementById('member-empty')!;
      const keys = items.map((el) => strip(el.querySelector('span')?.textContent || ''));

      const apply = () => {
        const words = strip(input.value).split(/\s+/).filter(Boolean);
        let n = 0;
        items.forEach((el, i) => {
          const show = words.every((w) => keys[i].includes(w));
          el.style.display = show ? '' : 'none';
          if (show) n++;
        });
        groups.forEach((g) => {
          const any = Array.from(g.querySelectorAll<HTMLElement>('.member-item')).some(
            (el) => el.style.display !== 'none'
          );
          g.style.display = any ? '' : 'none';
        });
        empty.classList.toggle('hidden', n > 0);
        count.textContent = words.length ? (n === 1 ? '1 μέλος' : `${n} μέλη`) : '';
      };

      input.value = new URLSearchParams(window.location.search).get('q') || '';
      input.addEventListener('input', apply);
      apply();
    };

    setup();
    document.addEventListener('astro:page-load', setup);
  </script>
</Layout>
