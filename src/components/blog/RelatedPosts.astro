---
// Οι σχετικές ανακοινώσεις στο τέλος μιας ανακοίνωσης. Μένουν μέσα στη στήλη της (θέση `below` του
// SinglePost.astro), με την ίδια γραμμή που έχει και η αρχική (ekas/PostRow.astro).
import { APP_BLOG } from 'astrowind:config';

import { getRelatedPosts } from '~/utils/blog';
import PostRow from '~/components/ekas/PostRow.astro';
import type { Post } from '~/types';

export interface Props {
  post: Post;
}

const { post } = Astro.props;

const relatedPosts = APP_BLOG.isRelatedPostsEnabled && post.tags ? await getRelatedPosts(post, 3) : [];
---

{
  relatedPosts.length > 0 && (
    <section class="mt-16">
      <h2 class="font-heading text-2xl text-heading">Σχετικές ανακοινώσεις</h2>
      <ul class="mt-6 divide-y divide-gray-200 border-y border-gray-200">
        {relatedPosts.map((related) => (
          <li>
            <PostRow post={related} excerpt={false} />
          </li>
        ))}
      </ul>
    </section>
  )
}
