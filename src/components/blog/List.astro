---
import Item from '~/components/blog/ListItem.astro';
import type { Post } from '~/types';

export interface Props {
  posts: Array<Post>;
}

const { posts } = Astro.props;
---

<ul class="divide-y divide-gray-200 border-y border-gray-200">
  {
    posts.map((post) => (
      <li class="py-10">
        <Item post={post} />
      </li>
    ))
  }
</ul>
