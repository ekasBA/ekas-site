---
// Το κέλυφος κάθε εσωτερικής σελίδας: ίδιο κενό κάτω από την κεφαλίδα, ίδια στήλη ανάγνωσης, ο τίτλος στην
// αριστερή ακμή της στήλης, ίδιο κενό από τον τίτλο ως το περιεχόμενο. Οι κανόνες των κενών είναι γραμμένοι
// στην κεφαλίδα του CustomStyles.astro.
// Η θέση `above` είναι για τη γραμμή πλοήγησης (breadcrumbs) όπου υπάρχει.
export interface Props {
  title: string;
  subtitle?: string;
}

const { title, subtitle } = Astro.props;
---

<section class="mx-auto max-w-7xl px-4 sm:px-6 pt-10 md:pt-12 pb-16 md:pb-24">
  <div class="ekas-column">
    <slot name="above" />
    <h1 class="font-heading text-4xl md:text-5xl leading-[1.12] text-heading">{title}</h1>
    {subtitle && <p class="mt-4 text-lg md:text-xl leading-relaxed text-muted">{subtitle}</p>}
    <div class="mt-8">
      <slot />
    </div>
  </div>
</section>
