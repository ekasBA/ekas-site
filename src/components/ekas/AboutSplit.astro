---
// Δύο φωτογραφίες η μία δίπλα στην άλλη και κείμενο δεξιά. Χωρίς διακοσμητικά σχήματα.
export interface Props {
  title: string;
  imageSmall: { src: string; alt: string };
  imageLarge: { src: string; alt: string };
  action?: { text: string; href: string };
}

const { title, imageSmall, imageLarge, action } = Astro.props;
---

<section class="mx-auto max-w-7xl px-4 sm:px-6 py-16 md:py-24">
  <div class="grid items-center gap-10 lg:grid-cols-[minmax(0,0.9fr)_minmax(0,1fr)] lg:gap-16">
    <div class="mx-auto flex w-full max-w-xl items-end gap-3">
      <img
        src={imageSmall.src}
        alt={imageSmall.alt}
        class="ekas-photo w-[34%] aspect-[3/5] object-cover"
        loading="lazy"
      />
      <img
        src={imageLarge.src}
        alt={imageLarge.alt}
        class="ekas-photo w-[66%] aspect-[6/7] object-cover"
        loading="lazy"
      />
    </div>

    <div>
      <h2 class="font-heading text-3xl md:text-4xl leading-tight text-heading">{title}</h2>
      <div class="mt-6 space-y-4 text-base leading-relaxed text-default">
        <slot />
      </div>
      {
        action && (
          <a href={action.href} class="btn-primary mt-8">
            {action.text}
          </a>
        )
      }
    </div>
  </div>
</section>

<style>
  .ekas-photo {
    border-radius: var(--ekas-radius);
  }
</style>
