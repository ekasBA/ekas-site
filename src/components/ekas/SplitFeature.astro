---
// Εικόνα αριστερά, τίτλος και κείμενο δεξιά.
export interface Props {
  title: string;
  image: { src: string; alt: string };
}

const { title, image } = Astro.props;
---

<section class="mx-auto max-w-7xl px-4 sm:px-6 pb-16 md:pb-24">
  <div class="grid items-center gap-10 md:grid-cols-2 lg:gap-16">
    <img src={image.src} alt={image.alt} class="ekas-feature-img w-full object-cover" loading="lazy" />
    <div>
      <h2 class="font-heading text-3xl md:text-4xl leading-[1.3] text-heading">{title}</h2>
      <div class="ekas-feature-text mt-6 space-y-4 text-base leading-relaxed text-default">
        <slot />
      </div>
    </div>
  </div>
</section>

<style>
  .ekas-feature-img {
    border-radius: var(--ekas-radius);
  }
  .ekas-feature-text :global(a) {
    color: var(--aw-color-primary);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
</style>
