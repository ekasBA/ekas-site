---
// Τα τρία πιο πρόσφατα νέα: το πιο πρόσφατο μεγάλο αριστερά, τα δύο προηγούμενα μικρά δεξιά.
// Δεν είναι τρεις ίδιες κάρτες στη σειρά: το μέγεθος δείχνει ποιο είναι το νεότερο.
// Οι εικόνες είναι αφίσες με κείμενο: φαίνονται ολόκληρες μέσα σε πλαίσιο (.ekas-poster του CustomStyles.astro).
import { findLatestPosts } from '~/utils/blog';
import { getPermalink, getBlogPermalink } from '~/utils/permalinks';
import { getFormattedDate } from '~/utils/utils';
import PostRow from '~/components/ekas/PostRow.astro';

export interface Props {
  title: string;
}

const { title } = Astro.props;
const [lead, ...rest] = await findLatestPosts({ count: 3 });
---

<section class="mx-auto max-w-7xl px-4 sm:px-6 pb-16 md:pb-24">
  <h2 class="font-heading text-3xl md:text-4xl text-heading">{title}</h2>

  <div class="mt-6 grid gap-10 lg:grid-cols-[minmax(0,1.35fr)_minmax(0,1fr)] lg:gap-16">
    {
      lead && (
        <a href={getPermalink(lead.permalink, 'post')} class="group block">
          {typeof lead.image === 'string' && (
            <div class="ekas-poster aspect-[16/9]">
              <img src={lead.image} alt="" loading="lazy" />
            </div>
          )}
          <time class="mt-4 block text-sm text-muted" datetime={String(lead.publishDate)}>
            {getFormattedDate(lead.publishDate)}
          </time>
          <h3 class="mt-1 font-heading text-2xl md:text-3xl leading-snug text-heading group-hover:text-primary">
            {lead.title}
          </h3>
          {lead.excerpt && <p class="mt-2 line-clamp-3 text-base leading-relaxed text-default">{lead.excerpt}</p>}
        </a>
      )
    }

    <div>
      <ul class="divide-y divide-gray-200 border-y border-gray-200">
        {
          rest.map((post) => (
            <li>
              <PostRow post={post} />
            </li>
          ))
        }
      </ul>
      {/* Κουμπί, όπως το «Διαβάστε περισσότερα» των άλλων ενοτήτων της αρχικής (χρήστης, 2026-11-17). */}
      <a href={getBlogPermalink()} class="btn-primary mt-8"> Όλες οι ανακοινώσεις </a>
    </div>
  </div>
</section>
